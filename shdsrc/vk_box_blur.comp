#version 450

layout (set = 0, binding = 0, rgba16f) readonly uniform image2D srcImage;
layout (set = 0, binding = 1, rgba16f) writeonly uniform image2D dstImage;

layout (set = 1, binding = 0) uniform BlurTargetUBO {
    float blur_size;
// Which of the two spans this pass sums. One box blur is the two of them run back to back.
    uint axis;
} blur_attr;

layout (local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

const int MAX_BLUR_RADIUS = 200;
const uint BLUR_AXIS_X = 0;

void main() {
    ivec2 size = imageSize(srcImage);
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= size.x || pixel.y >= size.y) {
        return;
    }
    vec3 accumulatedColor = imageLoad(srcImage, pixel).rgb;
    float scaled_radius = float(size.y) * blur_attr.blur_size;
    int max_radius = min(max(size.y - 1, 0), MAX_BLUR_RADIUS);
    float bounded_radius = isnan(scaled_radius) ? 0.0 : clamp(scaled_radius, 0.0, float(max_radius));
    int blur_radius = int(bounded_radius);
    if (blur_radius <= 0) {
        imageStore(dstImage, pixel, vec4(accumulatedColor, 1));
        return;
    }

    int sampleCount = 1;

    // Both spans in one pass would be a cross, whose corners are never sampled however often it repeats.
    if (blur_attr.axis == BLUR_AXIS_X) {
        for (int sampleX = max(0, pixel.x - blur_radius);
             sampleX <= min(size.x - 1, pixel.x + blur_radius); sampleX++) {
            if (sampleX == pixel.x) {
                continue;
            }
            accumulatedColor += imageLoad(srcImage, ivec2(sampleX, pixel.y)).rgb;
            sampleCount++;
        }
    } else {
        for (int sampleY = max(0, pixel.y - blur_radius);
             sampleY <= min(size.y - 1, pixel.y + blur_radius); sampleY++) {
            if (sampleY == pixel.y) {
                continue;
            }
            accumulatedColor += imageLoad(srcImage, ivec2(pixel.x, sampleY)).rgb;
            sampleCount++;
        }
    }
    vec4 color = vec4(accumulatedColor / sampleCount, 1);
    imageStore(dstImage, pixel, color);
}
