// ln(1+x) in double without a division: within 1.5 ulp on the GPU over 200000 tested values, and within 0.5 ulp for all 50000 from 1e3 to 1e6.
double log1p_d(double x) {
    if (x <= 0.0LF) {
        return 0.0LF;
    }
    double r = x;
    int k = 0;
    int j = 0;
    if (x >= 0.0078125LF) {
        // 1 + x only picks the entry and the exponent; below 2, r is taken from x itself, so its rounding never reaches the result.
        double u = 1.0LF + x;
        double m = frexp(u, k);
        j = int((unpackDouble2x32(m).y >> 13u) & 127u);
        double inv2c = LOG1P_TBL_INV2C[j];
        r = k == 1 ? fma(x, 0.5LF * inv2c, 0.5LF * inv2c - 1.0LF) : fma(m, inv2c, -1.0LF);
        k -= 1;
    }
    // ln(1+r) = r + r^2 q(r), the series to r^8, which |r| < 1/128 leaves below double's last bit.
    double q = fma(r, -1.0LF / 8.0LF, 1.0LF / 7.0LF);
    q = fma(q, r, -1.0LF / 6.0LF);
    q = fma(q, r, 1.0LF / 5.0LF);
    q = fma(q, r, -1.0LF / 4.0LF);
    q = fma(q, r, 1.0LF / 3.0LF);
    q = fma(q, r, -0.5LF);
    double p = (r * r) * q;
    double dk = double(k);
    // precise keeps the driver from folding these rounding-error terms to zero, which costs up to 120 ulp near x = 1/128.
    precise double t = dk * LOG1P_LN2_HI;
    precise double a = t + LOG1P_TBL_LOGC_HI[j];
    precise double ea = (t - a) + LOG1P_TBL_LOGC_HI[j];
    precise double hi = a + r;
    precise double eh = (a - hi) + r;
    return hi + (((fma(dk, LOG1P_LN2_LO, LOG1P_TBL_LOGC_LO[j]) + ea) + eh) + p);
}

