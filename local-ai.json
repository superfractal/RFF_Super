{
  "endpoint": "http://127.0.0.1:18080/v1/chat/completions",
  "max_errors": 5,
  "max_refinements": 3,
  "model": "bonsai-2-27b",
  "request": {
    "chat_template_kwargs": {
      "enable_thinking": true,
      "reasoning_effort": "medium"
    },
    "max_tokens": 8192,
    "min_p": 0.0,
    "presence_penalty": 0.0,
    "repeat_penalty": 1.0,
    "temperature": 1.0,
    "top_k": 20,
    "top_p": 0.95
  },
  "timeout_seconds": 600,
  "vision": true
}
